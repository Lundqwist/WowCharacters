# Copy to /volume1/docker/wowcharacters/.env on the NAS (mode 600) and fill in.
# A Blizzard API client (develop.battle.net, OAuth2 client credentials).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# A long random secret (at least 32 characters) that lets the StoryMaker program post stories.
# The same value goes in the STORY_TOKEN user environment variable on the PC that runs StoryMaker.
# Empty: posting stories is off.
STORY_TOKEN=
